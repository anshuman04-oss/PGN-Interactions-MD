########################################################
# Start of charge, pairs, and long range interactions
########################################################
set type 1 charge 0
set type 2 charge 1
pair_style lj/cut/coul/long 8 10
kspace_style pppm 1.0e-4

pair_coeff 1 1 1.0 10.0 10.0 # Nanoparticle O
pair_coeff 1 2 1.0 5.5 5.5 # O-P
pair_coeff 2 2 1.0 1.0 1.0 # Polymer P
pair_modify shift yes

special_bonds lj 0.0 1.0 1.0
special_bonds coul 0.0 1.0 1.0
###################################
# Start of bonded interactions
###################################
bond_style harmonic
angle_style harmonic
bond_coeff 1 100 5.5	# O-P
angle_coeff * 0 180	# all angle types