# series runs - one by one - minimization
units  real
boundary p p p
atom_style full
read_data initialsys.config
log log-min.txt
include forcefield.lmp

#groups
group g1 id 1 2 32 62 92

# Input parameter initialisation
neigh_modify every 1 delay 0 check yes page 100000 one 5000
velocity all create 1.0 4928459 rot yes dist gaussian

fix 1 all nvt temp 1.0 1.0 100.0
fix 2 g1 rigid/nvt molecule temp 1.0 1.0 1.0

thermo_style custom step temp press vol density pe ke etotal spcpu 
timestep  0.005
# Minimization and equilibration
dump 1 all atom 100 trajmin.lammpstrj
#minimize 1.0e-4 1.0e-6 1000000 100
run 500000
write_data after.config
print " ******* "
print " ****** finished energy minimization *******"
print " ******* "
print "Done"