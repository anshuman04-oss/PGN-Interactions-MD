########################################################
# Start of charge, pairs, and long range interactions
########################################################
set type 1 charge 0
set type 2 charge 0
pair_style lj/cut 2.5
#kspace_style pppm 1.0e-4

pair_coeff 1 1 1.0 5.0 12.5 # Nanoparticle O
pair_coeff 1 2 1.0 3.0 7.5 # O-P
pair_coeff 2 2 1.0 1.0 2.5 # Polymer P
pair_modify shift yes

special_bonds lj/coul 0.0 0.0 0.0
###################################
# Start of bonded interactions
###################################
bond_style harmonic
angle_style harmonic
bond_coeff 1 100 3.0	# O-P
bond_coeff 2 100 1.0	# P-P
angle_coeff * 5 180	# all angle types